{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "WINEROSE_BUILD_PLUGIN": "ON",
        "WINEROSE_BUILD_TESTS": "ON",
        "WINEROSE_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "core-only",
      "hidden": true,
      "description": "params / engine / presets / control + tests and JUCE-free tools; JUCE is not downloaded",
      "cacheVariables": { "WINEROSE_BUILD_PLUGIN": "OFF" }
    },
    {
      "name": "vs2026",
      "displayName": "Windows: Visual Studio 2026 (needs CMake >= 4.2, e.g. the one bundled with VS)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2026-core",
      "displayName": "Windows: Visual Studio 2026, core layers only",
      "inherits": ["core-only", "vs2026"]
    },
    {
      "name": "vs2022",
      "displayName": "Windows: Visual Studio 2022",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "ninja",
      "displayName": "Ninja Multi-Config (any OS; on Windows run from a VS developer shell)",
      "inherits": "base",
      "generator": "Ninja Multi-Config"
    },
    {
      "name": "ninja-core",
      "displayName": "Ninja Multi-Config, core layers only (used by Linux/macOS CI)",
      "inherits": ["core-only", "ninja"]
    }
  ],
  "buildPresets": [
    { "name": "vs2026-release",      "configurePreset": "vs2026",      "configuration": "Release" },
    { "name": "vs2026-debug",        "configurePreset": "vs2026",      "configuration": "Debug" },
    { "name": "vs2026-core-debug",   "configurePreset": "vs2026-core", "configuration": "Debug" },
    { "name": "vs2022-release",      "configurePreset": "vs2022",      "configuration": "Release" },
    { "name": "ninja-release",       "configurePreset": "ninja",       "configuration": "Release" },
    { "name": "ninja-core-release",  "configurePreset": "ninja-core",  "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "vs2026-release",     "inherits": "base", "configurePreset": "vs2026",      "configuration": "Release" },
    { "name": "vs2026-debug",       "inherits": "base", "configurePreset": "vs2026",      "configuration": "Debug" },
    { "name": "vs2026-core-debug",  "inherits": "base", "configurePreset": "vs2026-core", "configuration": "Debug" },
    { "name": "vs2022-release",     "inherits": "base", "configurePreset": "vs2022",      "configuration": "Release" },
    { "name": "ninja-release",      "inherits": "base", "configurePreset": "ninja",       "configuration": "Release" },
    { "name": "ninja-core-release", "inherits": "base", "configurePreset": "ninja-core",  "configuration": "Release" }
  ]
}
